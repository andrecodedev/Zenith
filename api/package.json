{
  "name": "zenith-music-api",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup:ytdlp": "curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux -o yt-dlp_linux && chmod a+rx yt-dlp_linux",
    "setup:realesrgan": "node setup-realesrgan.js",
    "postinstall": "npm run setup:ytdlp && npm run setup:realesrgan"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "image-size": "^2.0.2",
    "multer": "^2.2.0",
    "yt-search": "^2.11.1"
  }
}
